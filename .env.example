# --- Base de datos (Neon) ---
# Console > proyecto registro-gastos > Connection string > "Prisma" o "Node.js"
# Agregar sslmode=require (Neon ya lo exige).
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require"

# --- Sesión / cifrado ---
# Generar con: openssl rand -base64 48
AUTH_SECRET="reemplazar-por-48-bytes-aleatorios"
# Clave de 32 bytes (base64) para cifrar el refresh token de Gmail en la base.
# Generar con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Gmail / Google OAuth ---
# Crear en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Debe coincidir exactamente con la redirect URI registrada en Google.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# Dominios de remitente aceptados para importar consumos de tarjeta (separados por coma).
GMAIL_ALLOWED_SENDER_DOMAINS="itau.com.uy,itau.com"

# Notificaciones push de Gmail por Pub/Sub (opcionales; se configuran juntas).
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUBSUB_AUDIENCE=""
GMAIL_PUBSUB_SERVICE_ACCOUNT=""

# --- Cron de sincronización (Vercel) ---
# Vercel Cron envía: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
